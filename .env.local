# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workwala

# Auth
# IMPORTANT: These are strong random secrets — do NOT commit this file to version control.
NEXTAUTH_SECRET=c4c0f96330afb903396e8a64415721fbb2363f80bccd4d47b60b8d89c5ead21b728b0039ee4832b32571b4f8ffea3a6a
NEXTAUTH_URL=http://localhost:3000

# JWT — must be a long random string, never a guessable value
JWT_SECRET=b7d3cfe62bf3fcb591f02f59d35dbc0437bbcaa0a6381279c01a891de360a9f9ef1f2e9f856a2b041807f933348e7a36

# JWT Refresh — separate secret for refresh tokens (MUST differ from JWT_SECRET)
JWT_REFRESH_SECRET=d79fee19fdb0d9247f9672d17218a930fbd87c1199439ba45376dfe9d2fbfc0dfa88d1d538b9d2245ef923cf5c2f5329

# OTP HMAC pepper — required for OTP hashing; server refuses to start without this
OTP_PEPPER=e6c8287f8c0908ce3852892c802049692748373f1d8385e203986752c2e4b8814597dd440e35dc321b1e34dde652658d

# Mail (SMTP)
# Replace with real credentials before sending any email.
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords).
# Alternatively, configure mail in Admin → Settings → Mail (stored in DB).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=REPLACE_WITH_REAL_APP_PASSWORD
MAIL_FROM=your@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID_TEST=
RAZORPAY_KEY_SECRET_TEST=
RAZORPAY_KEY_ID_LIVE=
RAZORPAY_KEY_SECRET_LIVE=

# App Store / Play Store review account
# OTP "123456" is always accepted for this phone number even in production.
REVIEW_PHONE=9999999999

# Global OTP Bypass (TESTING ONLY - DANGEROUS IN PRODUCTION!)
# When set to "true", ANY phone number can use OTP "123456" to login.
# ⚠️ WARNING: This bypasses ALL authentication security. Use only for testing!
ALLOW_BYPASS_FOR_ALL=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Linko
